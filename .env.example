# DeepL API Free key: https://www.deepl.com/en/your-account/keys
DEEPL_API_KEY=
DEEPL_TARGET=EN-GB
FETCH_INTERVAL_MINUTES=30
RETENTION_DAYS=30

# Password protection (leave empty only for local dev: the site is then open).
# Generate the hash with: uv run python -m app.auth 'your-password'
BASIC_AUTH_USER=me
BASIC_AUTH_HASH=
